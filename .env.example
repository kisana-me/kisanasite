# 計測。本番のみ
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# サイトのURL。og:url と画像の絶対URLに使う
NEXT_PUBLIC_APP_URL=https://kisana.me/

# お問い合わせフォームの送り先（components/inquiry_form.js）。
# CMS は Origin を見てサイトを決めるので、sites.url に登録したオリジンから
# しか通らない。localhost からは 403 になる
NEXT_PUBLIC_CMS_API_BASE=https://cms.ivecolor.com
# Turnstile のサイトキー。公開値。空ならウィジェットを出さない
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 記事の取得元（scripts/site-data.mjs）
#   fixture (既定) … fixtures/site-data.json を読む。CMS が無くてもビルドできる
#   api             … headless-cms の /export/build.json を fetch する
SITE_DATA_SOURCE=fixture

# SITE_DATA_SOURCE=api のときだけ要る。
# トークンは CMS のサイト設定に平文で出ている値をそのまま入れる
STUDIO_EXPORT_URL=https://cms.ivecolor.com/export/build.json
STUDIO_EXPORT_TOKEN=
